<?php

// 1. Calculate Simple Interest

echo " 1. Simple Interest \n";


$principal = 5000;
$rate = 5;
$time = 3;

$simpleInterest = ($principal * $rate * $time) / 100;


echo "Principal Amount: $principal\n";
echo "Rate of Interest: $rate%\n";
echo "Time Period: $time years\n";
echo "Simple Interest: $simpleInterest\n\n";


// 2. Check Prime Number

echo "2. Prime Number Check\n";


$number = 17;
$isPrime = true;


if ($number < 2) {
    $isPrime = false;
} else {
    for ($i = 2; $i <= sqrt($number); $i++) {
        if ($number % $i == 0) {
            $isPrime = false;
            break;
        }
    }
}

echo "Number to check: $number\n";
if ($isPrime) {
    echo "$number is a Prime number.\n\n";
} else {
    echo "$number is NOT a Prime number.\n\n";
}


// 3. Calculate Factorial

echo "3. Factorial \n";


$num = 5;
$factorial = 1;


for ($i = 1; $i <= $num; $i++) {
    $factorial *= $i;
}

echo "Given Number: $num\n";
echo "Factorial of $num is: $factorial\n\n";


// 4. Sum and Average of Array

echo "========== 4. Sum and Average of Array ==========\n";


$numbers = [10, 20, 30, 40, 50];
$sum = 0;
$count = count($numbers);


for ($i = 0; $i < $count; $i++) {
    $sum += $numbers[$i];
}


$average = $sum / $count;


echo "Array Elements: ";
foreach ($numbers as $value) {
    echo $value . " ";
}
echo "\n";
echo "Total Elements: $count\n";
echo "Sum of all elements: $sum\n";
echo "Average of all elements: $average\n\n";


// 5. Print Pattern using Nested Loop

echo "5. Pattern ";


$rows = 4;


echo "Pattern:\n";
for ($i = 1; $i <= $rows; $i++) {
    for ($j = 1; $j <= $i; $j++) {
        echo $i . " ";
    }
    echo "\n";
}
?>